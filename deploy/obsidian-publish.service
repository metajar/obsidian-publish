# systemd unit for the Obsidian Publish server.
#
# Install as /etc/systemd/system/obsidian-publish.service, then:
#   systemctl daemon-reload
#   systemctl enable --now obsidian-publish
#
# The service runs as a dedicated low-privilege system user. Create it once:
#
#   sudo useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin \
#        --comment "Obsidian Publish server" obsidian-publish
#
# State (SQLite DB, API token, session secret) lives under
# /var/lib/obsidian-publish, created and owned automatically by
# StateDirectory=. The API token is generated on first start and printed
# ONCE to the journal — see deploy/droplet.md for how to read it.

[Unit]
Description=Obsidian Publish server
# Full deploy walkthrough (droplet variant): deploy/droplet.md in the repo.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- Identity ---------------------------------------------------------------
# Dedicated low-privilege user (see the useradd command in the header comment).
User=obsidian-publish
Group=obsidian-publish

# --- Placeholders: EDIT THESE ----------------------------------------------
# Path to the compiled binary (see README.md for cross-compile commands):
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o obsidian-publish-server ./cmd/server
ExecStart=/usr/local/bin/obsidian-publish-server
# Listen on loopback only when a reverse proxy or tunnel runs on the same
# host (recommended: Caddy, nginx, or cloudflared). Use ":8080" to listen on
# all interfaces.
Environment=OBSPUB_ADDR=127.0.0.1:8080
# Public URL used to build live page links; set to your real hostname.
# PLACEHOLDER — replace with your own domain:
#Environment=OBSPUB_BASE_URL=https://notes.example.com

# State lives in /var/lib/obsidian-publish (created by StateDirectory below).
Environment=OBSPUB_DB=/var/lib/obsidian-publish/obsidian-publish.db
Environment=OBSPUB_TOKEN_FILE=/var/lib/obsidian-publish/api-token
Environment=OBSPUB_SECRET_FILE=/var/lib/obsidian-publish/session-secret

# Optional overrides file (must exist; prefix '-' to tolerate absence).
# Put ONLY non-secret overrides here, e.g. OBSPUB_BASE_URL. NEVER put real
# secrets in a unit-managed file readable beyond root — the API token and
# session secret are generated by the server itself into the data dir.
#EnvironmentFile=-/etc/obsidian-publish/obsidian-publish.env

# --- Lifecycle ---------------------------------------------------------------
Restart=on-failure
RestartSec=5s

# --- State -------------------------------------------------------------------
StateDirectory=obsidian-publish
WorkingDirectory=/var/lib/obsidian-publish
# The token (0600) and secret (0600) must stay private to this user.
UMask=0077

# --- Hardening ---------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/obsidian-publish
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
